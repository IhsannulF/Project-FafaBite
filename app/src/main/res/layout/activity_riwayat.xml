<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fafa_blue_primary">

    <!-- ========================================== -->
    <!-- KONTEN HALAMAN RIWAYAT -->
    <!-- ========================================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header Title -->
            <TextView
                android:id="@+id/tvHeaderRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Riwayat Pesanan"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Filter Tanggal / Status (Pill buttons) -->
            <HorizontalScrollView
                android:id="@+id/scrollFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderRiwayat">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filter Aktif -->
                    <TextView
                        android:id="@+id/btnFilterSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_pill"
                        android:backgroundTint="@color/white"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="8dp"
                        android:text="Semua"
                        android:textColor="@color/fafa_blue_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFilterSelesai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_input_pill"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="8dp"
                        android:text="Selesai"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/btnFilterDiproses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_input_pill"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="8dp"
                        android:text="Diproses"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/btnFilterSiap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_input_pill"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="8dp"
                        android:text="Siap Diambil"
                        android:textColor="@color/white" />


                </LinearLayout>
            </HorizontalScrollView>

            <!-- Wadah Putih Melengkung -->
            <View
                android:id="@+id/whiteContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_top_rounded_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollFilter" />

            <!-- Daftar Riwayat Pesanan -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRiwayatPesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="120dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="@id/whiteContainer" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- ========================================== -->
    <!-- NAVBAR BAWAH (BottomAppBar) -->
    <!-- ========================================== -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:backgroundTint="@color/white"
        app:fabAlignmentMode="center"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="24dp"
        app:fabCradleVerticalOffset="6dp">

        <!-- Ini tag pembuka BottomNavigationView -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/text_grey"
            app:itemTextColor="@color/text_grey"
            app:menu="@menu/bottom_nav_menu" />
        <!-- Ini tag penutup bawaan dari BottomNavigationView /> (ada garis miring di akhirnya) -->

        <!-- INILAH TAG PENUTUP YANG SERING HILANG (Wajib Ada!) -->
    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- ========================================== -->
    <!-- TOMBOL TENGAH MELAYANG (Cari Lokasi) -->
    <!-- ========================================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCariLokasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Cari Lokasi"
        app:backgroundTint="@color/fafa_blue_primary"
        app:elevation="6dp"
        app:layout_anchor="@id/bottomAppBar"
        app:maxImageSize="28dp"
        app:srcCompat="@android:drawable/ic_dialog_map"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>